// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  idUsuario             Int       @id @default(autoincrement())
  nombreUsuario  String    @unique
  contrasena     String
  fincaId        Int?
  finca          InformacionFinca? @relation(fields: [fincaId], references: [idFinca])
  ingresos       Ingreso[]
  gastos         Egreso[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model InformacionFinca {
  idFinca            Int                 @id @default(autoincrement())
  nombreFinca        String?   
  direccion          String?                      
  latitud            String?             
  longitud           String?             
  cultivos           InventarioCultivo[]
  usuarios           Usuario[]
  inventarioProductos InventarioProducto[]
  ingresos           Ingreso[]
  gastos             Egreso[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("Informacion_finca")
}

model UnidadMedida {
  idUnidadMedida Int                 @id @default(autoincrement())
  nombre         String             @db.VarChar(45)
  cultivos       InventarioCultivo[]
  productos      InventarioProducto[]
  actividades    Actividad[]

  @@map("UnidadMedida")
}

model Cultivo {
  idCultivo          Int       @id @default(autoincrement())
  nombre      String
  tipo        String
  produccion  Decimal?   @db.Decimal(10,2)
  fechaInicio DateTime
  fechaFin    DateTime?
  idEstado      Int

  estado      Estado              @relation(fields: [idEstado], references: [idEstado])
  inventario  InventarioCultivo?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventarioCultivo {
  idInventarioCultivo Int       @id @default(autoincrement())
  idFinca             Int
  cultivoId           Int       @unique
  fechaSiembra        DateTime?
  fechaCosecha        DateTime?
  produccion          Decimal?   @db.Decimal(10,2)
  estado              String?    @db.VarChar(45)
  descripcion         String?    
  areaSembrada        Decimal?   @db.Decimal(10,2)
  idUnidadMedida      Int?

  cultivo       Cultivo         @relation(fields: [cultivoId], references: [idCultivo])
  finca         InformacionFinca @relation(fields: [idFinca], references: [idFinca])
  unidadMedida  UnidadMedida?    @relation(fields: [idUnidadMedida], references: [idUnidadMedida])
  actividades   Actividad[]
  aplicaciones  Aplicacion[]
  recordatorios Recordatorio[]
  ingresos      Ingreso[]
  gastos        Egreso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("InventarioCultivo")
}

model Producto {
  idProducto   Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  inventario   InventarioProducto?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventarioProducto {
  idInventarioProducto Int     @id @default(autoincrement())
  cantidad             Decimal @db.Decimal(10,2)
  idUnidadMedida       Int?
  idProducto           Int     @unique
  idFinca              Int?

  producto     Producto           @relation(fields: [idProducto], references: [idProducto])
  unidadMedida UnidadMedida?      @relation(fields: [idUnidadMedida], references: [idUnidadMedida])
  finca        InformacionFinca?  @relation(fields: [idFinca], references: [idFinca])
  aplicaciones Aplicacion[]
  ingresos      Ingreso[]
  gastos        Egreso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("InventarioProducto")
}

model Actividad {
  idActividad    Int      @id @default(autoincrement())
  idCultivo      Int
  nombre         String   @db.VarChar(45)
  descripcion    String?  
  costo          Decimal? @db.Decimal(10,2)
  idUnidadMedida Int?
  importancia    String 

  cultivo      InventarioCultivo @relation(fields: [idCultivo], references: [idInventarioCultivo])
  unidadMedida UnidadMedida?     @relation(fields: [idUnidadMedida], references: [idUnidadMedida])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Actividad")
}

model Aplicacion {
  idAplicacion         Int      @id @default(autoincrement())
  idCultivo            Int
  idInventarioProducto Int
  cantidad             Decimal  @db.Decimal(10,2)
  fecha                DateTime

  cultivo      InventarioCultivo  @relation(fields: [idCultivo], references: [idInventarioCultivo])
  producto     InventarioProducto @relation(fields: [idInventarioProducto], references: [idInventarioProducto])
  recordatorios Recordatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Aplicacion")
}

model Recordatorio {
  idRecordatorio Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(100)
  descripcion    String?  
  fecha          DateTime
  estado         String   @default("pendiente") @db.VarChar(20)
  idCultivo      Int
  idAplicacion   Int?     

  cultivo     InventarioCultivo @relation(fields: [idCultivo], references: [idInventarioCultivo])
  aplicacion  Aplicacion?       @relation(fields: [idAplicacion], references: [idAplicacion])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Recordatorio")
}

model Estado {
  idEstado    Int        @id @default(autoincrement())
  nombre    String
  cultivos  Cultivo[]
}

model Ingreso {
  idIngreso                   Int       @id @default(autoincrement())
  descripcion          String
  monto                Float
  fecha                DateTime  @default(now())
  usuarioId            Int
  idInventarioCultivo  Int?
  idInventarioProducto Int?
  fincaId       Int
  
  finca       InformacionFinca @relation(fields: [fincaId], references: [idFinca])
  usuario     Usuario            @relation(fields: [usuarioId], references: [idUsuario])
  cultivo     InventarioCultivo? @relation(fields: [idInventarioCultivo], references: [idInventarioCultivo])
  producto    InventarioProducto? @relation(fields: [idInventarioProducto], references: [idInventarioProducto])
}

model Egreso {
  idGasto              Int       @id @default(autoincrement())
  descripcion          String
  monto                Float
  fecha                DateTime  @default(now())
  usuarioId            Int
  idInventarioCultivo  Int?
  idInventarioProducto Int?
  fincaId       Int
  finca       InformacionFinca @relation(fields: [fincaId], references: [idFinca])
  usuario     Usuario            @relation(fields: [usuarioId], references: [idUsuario])
  cultivo     InventarioCultivo? @relation(fields: [idInventarioCultivo], references: [idInventarioCultivo])
  producto    InventarioProducto? @relation(fields: [idInventarioProducto], references: [idInventarioProducto])
}

