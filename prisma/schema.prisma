// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  idUsuario      Int       @id @default(autoincrement())
  nombreUsuario  String    @unique
  contrasena     String
  fincaId        Int?
  finca          InformacionFinca? @relation(fields: [fincaId], references: [idFinca])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model InformacionFinca {
  idFinca            Int                 @id @default(autoincrement())
  nombreFinca        String?   
  direccion          String?                      
  latitud            String?             
  longitud           String?             
  cultivos           InventarioCultivo[]
  usuarios           Usuario[]
  inventarioProductos InventarioProducto[]
  ingresos           Ingreso[]
  gastos             Egreso[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("Informacion_finca")
}

model UnidadMedida {
  idUnidadMedida Int                 @id @default(autoincrement())
  nombre         String             @db.VarChar(45)
  cultivos       InventarioCultivo[]
  productos      InventarioProducto[]
  actividades    Actividad[]

  @@map("UnidadMedida")
}

model Cultivo {
  idCultivo   Int       @id @default(autoincrement())
  nombre      String
  tipo        String
  produccion  Decimal?   @db.Decimal(10,2)
  fechaInicio DateTime
  fechaFin    DateTime?
  idEstado      Int
  areaSembrada       Decimal?   @db.Decimal(10,2)
  estado      Estado              @relation(fields: [idEstado], references: [idEstado])
  inventario  InventarioCultivo[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Aplicacion Aplicacion[]

  Actividad Actividad[]

  Recordatorio Recordatorio[]
}

model InventarioCultivo {
  idInventarioCultivo Int       @id @default(autoincrement())
  idFinca             Int
  cultivoId           Int     
  descripcion         String?    
  idUnidadMedida      Int?
  cultivo       Cultivo         @relation(fields: [cultivoId], references: [idCultivo])
  finca         InformacionFinca @relation(fields: [idFinca], references: [idFinca])
  unidadMedida  UnidadMedida?    @relation(fields: [idUnidadMedida], references: [idUnidadMedida])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("InventarioCultivo")
}

model Producto {
  idProducto   Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  inventario   InventarioProducto[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventarioProducto {
  idInventarioProducto Int      @id @default(autoincrement())
  stock                Decimal  @db.Decimal(10,2) 
  idUnidadMedida       Int?
  idProducto           Int       
  idFinca              Int?

  producto     Producto           @relation(fields: [idProducto], references: [idProducto])
  unidadMedida UnidadMedida?      @relation(fields: [idUnidadMedida], references: [idUnidadMedida])
  finca        InformacionFinca?  @relation(fields: [idFinca], references: [idFinca])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("InventarioProducto")
  
  Aplicacion Aplicacion[]
}

model Actividad {
  idActividad          Int      @id @default(autoincrement())
  idCultivo            Int
  nombre               String
  descripcion          String?
  costo                Decimal? @db.Decimal(10,2)
  importancia          String?
  fecha                DateTime
  idUnidadMedida       Int?
  cantidad             Decimal? @db.Decimal(10,2)
  idAplicacion         Int 

  cultivo     Cultivo        @relation(fields: [idCultivo], references: [idCultivo])
  aplicacion  Aplicacion     @relation(fields: [idAplicacion], references: [idAplicacion])
  unidadMedida UnidadMedida? @relation(fields: [idUnidadMedida], references: [idUnidadMedida])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Actividad")
}

model Aplicacion {
  idAplicacion         Int      @id @default(autoincrement())
  idCultivo            Int
  idInventarioProducto Int
  cantidad             Decimal  @db.Decimal(10,2)
  fecha                DateTime

  cultivo      Cultivo  @relation(fields: [idCultivo], references: [idCultivo])
  producto     InventarioProducto @relation(fields: [idInventarioProducto], references: [idInventarioProducto])
  recordatorios Recordatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Actividad Actividad[]
  @@map("Aplicacion")
  
}

model Recordatorio {
  idRecordatorio Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(100)
  descripcion    String?  
  fecha          DateTime
  estado         String   @default("pendiente") @db.VarChar(20)
  id_Cultivo      Int
  id_Aplicacion   Int?     

  cultivo     Cultivo @relation(fields: [id_Cultivo], references: [idCultivo])
  aplicacion  Aplicacion?@relation(fields: [id_Aplicacion], references: [idAplicacion])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Recordatorio")
}

model Estado {
  idEstado    Int        @id @default(autoincrement())
  nombre    String
  cultivos  Cultivo[]
}

model Ingreso {
  idIngreso            Int       @id @default(autoincrement())
  descripcion          String
  monto                Float
  fecha                DateTime  @default(now())
  usuarioId            Int
  idInventarioCultivo  Int?
  idInventarioProducto Int?
  fincaId       Int
  
  finca       InformacionFinca @relation(fields: [fincaId], references: [idFinca])
}

model Egreso {
  idGasto              Int       @id @default(autoincrement())
  descripcion          String
  monto                Float
  fecha                DateTime  @default(now())
  usuarioId            Int
  idInventarioCultivo  Int?
  idInventarioProducto Int?
  fincaId       Int
  finca       InformacionFinca @relation(fields: [fincaId], references: [idFinca])


}

